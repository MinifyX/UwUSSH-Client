{
  "name": "uwussh",
  "version": "0.1.0-beta.9",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @uwussh/desktop dev",
    "tauri": "pnpm --filter @uwussh/desktop tauri",
    "build": "pnpm --filter @uwussh/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "prettier --check . && node scripts/check-i18n.mjs",
    "format": "prettier --write .",
    "build:setup": "node scripts/build-setup.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
