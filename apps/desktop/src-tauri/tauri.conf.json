{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UwUSSH",
  "version": "0.1.0-beta.4",
  "identifier": "app.uwussh.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UwUSSH",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzQTE5NUNDOUU2Nzk5MEMKUldRTW1XZWV6SldobzNpMWFUTlJldS9zNkhkTEJZZGN3cVphelhoZUtTT1duWEFYZVdjUVRMTk0K",
      "endpoints": ["https://raw.githubusercontent.com/MinifyX/UwUSSH-Client/updates/beta.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "UwUSSH",
    "homepage": "https://github.com/MinifyX/UwUSSH-Client",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "copyright": "GPL-3.0-only",
    "license": "GPL-3.0-only",
    "shortDescription": "SSH client with self-hosted encrypted sync",
    "longDescription": "The SSH client I build for myself, because every other one annoyed me. Termius-clean, PuTTY-deep, with a sync server that is yours."
  }
}
